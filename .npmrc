# Local, zero-cost development defaults.
# The workspace sandbox may deny writes to ~/.npm, so redirect cache/logs to a
# project-local directory. This file is committed so every machine behaves the
# same way; it never contacts a paid registry or a private proxy.
cache=./.npm-cache
logs-dir=./.npm-logs
fund=false
audit=false
save-exact=true

# Build scripts that are permitted to run. These are local, offline steps
# (Prisma engine download is fetched from the public npm registry as a normal
# package dependency; embedded-postgres only unpacks bundled binaries).
onlyBuiltDependencies[]=@prisma/engines
onlyBuiltDependencies[]=@prisma/client
onlyBuiltDependencies[]=prisma
onlyBuiltDependencies[]=@embedded-postgres/darwin-x64
onlyBuiltDependencies[]=@embedded-postgres/darwin-arm64
