# ============================================================================
# Open Import OS - environment example
# Copy to .env and edit. NEVER commit a real .env (see .gitignore).
# No paid service is required for local development.
# ============================================================================

# --- Runtime mode -----------------------------------------------------------
# DEMO seeds synthetic tenants/data. REAL is the live tenant namespace.
DATA_MODE=DEMO

# --- Database ---------------------------------------------------------------
# Local, zero-cost PostgreSQL provided by scripts/setup-local.mjs
# (embedded-postgres downloads binaries from the public npm registry).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/open_import_os
# Separate isolated database used by `pnpm restore:verify` so a restore can
# never overwrite the working database.
RESTORE_VERIFY_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/open_import_os_restore_check

# --- Auth -------------------------------------------------------------------
# 32+ random bytes. Generated by scripts/setup-local.mjs if left empty.
SESSION_SECRET=
# Cookie name; keep the default unless you run two apps on one host.
SESSION_COOKIE_NAME=oios_session
# Seconds. HttpOnly + SameSite=Lax are enforced in code, not configurable to
# a weaker value.
SESSION_TTL_SECONDS=2592000

# --- Outbound sending -------------------------------------------------------
# MUST stay false until a channel is connected AND authorized.
# Default false = no real email/DM can ever leave the system.
OUTBOUND_SEND_ENABLED=false
# Conservative human-follow-up policy (days between follow-ups).
FOLLOWUP_MAX_COUNT=2
FOLLOWUP_INTERVAL_DAYS=7
# Trial-run outbound cap per day when sending is enabled.
OUTBOUND_DAILY_CAP=10

# --- Growth schedule --------------------------------------------------------
# Stored per-organization in the database; these are defaults for new orgs.
# The worker never changes the OS timezone.
GROWTH_DAILY_AT=09:00
GROWTH_TIMEZONE=Asia/Shanghai
GROWTH_DAILY_TARGET=20
GROWTH_DAILY_MAX=50
GROWTH_DRAFTS_PER_RUN=10

# --- LLM / providers (all optional) ----------------------------------------
# If unset, the system runs in RULE_BASED mode. No fee can ever be incurred
# without an explicit key present here.
UNIAI_BASE_URL=
UNIAI_API_KEY=
UNIAI_MODEL=
# Which provider the classification/cost agents may use.
LLM_PROVIDER=RULE_BASED

# --- Object storage ---------------------------------------------------------
# Local directory by default; swap for S3-compatible storage later.
STORAGE_DRIVER=LOCAL
STORAGE_LOCAL_DIR=./.storage
# Only used when STORAGE_DRIVER=S3. Left empty keeps everything local.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Webhooks ---------------------------------------------------------------
# HMAC-SHA256 signing secret for outbound webhook deliveries.
WEBHOOK_SIGNING_SECRET=

# --- Public base URL (used in links only) -----------------------------------
APP_BASE_URL=http://127.0.0.1:57831

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=info
# true | false - when true, log lines are redacted of secrets/PII.
LOG_REDACT=true
